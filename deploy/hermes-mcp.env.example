# Docker Compose substitutions
MCP_HOSTNAME=hermes.example.com
HERMES_NETWORK=hermes_default
TRAEFIK_NETWORK=traefik_default
TRAEFIK_CERT_RESOLVER=letsencrypt
# HERMES_API_URL=http://hermes-agent:8642
# HERMES_MCP_ENV_FILE=./hermes-mcp.env
# Required only for the Hostinger sidecar override. Resolve this path from
# the existing Hostinger application's Compose directory.
# HERMES_MCP_BUILD_CONTEXT=./hermes-mcp

# hermes-mcp runtime settings
OAUTH_CLIENT_ID=replace-with-hermes-mcp-mint-client-output
OAUTH_CLIENT_SECRET=replace-with-at-least-32-characters
HERMES_API_KEY=replace-with-the-hermes-gateway-api-server-key
HERMES_MODEL=hermes-agent
HERMES_REQUEST_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# Optional second auth path for clients that cannot complete OAuth.
# MCP_BEARER_TOKEN=replace-with-hermes-mcp-mint-bearer-token-output
